# Copy this file to .env.local and fill in what you have.
# .env.local is git-ignored. NEVER commit real keys. All AI calls are server-side only.
# Without any keys the app still runs: the "Try a sample" demo works and sharing is disabled.

# --- Gemini (primary AI) -------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Cloudflare Workers AI (fallback AI, optional) -----------------------------
# Account ID: Cloudflare dashboard -> Workers & Pages (right sidebar)
# API token: dash.cloudflare.com/profile/api-tokens -> Create Token -> "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Supabase (share links, optional) ------------------------------------------
# Project Settings -> API. The service-role key is SECRET: server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo mode -----------------------------------------------------------------
# true = if the AI fails or takes longer than 15 s, use the pre-saved results for the
# sample prescriptions so a stage demo never breaks.
DEMO_MODE=true
